{
  "layer": "top",
  "position": "bottom",
  "height": 58,
  "spacing": 6,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": [],
  "modules-center": ["hyprland/taskbar"],
  "modules-right": ["pulseaudio", "network", "battery", "clock", "custom/voice"],

  "hyprland/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "tooltip": true,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-right": "close",
    "sort-by-number": true,
    "ignore-list": ["topu-voice", "mako"]
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 10
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip": true
  },

  "network": {
    "format-wifi":          "󰖩 {essid}",
    "format-ethernet":      "󰈀 {ipaddr}",
    "format-disconnected":  "󰖪 Offline",
    "tooltip-format-wifi":  "{essid} — {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} — {ipaddr}",
    "interval": 5
  },

  "battery": {
    "format":           "{icon} {capacity}%",
    "format-charging":  "󰂄 {capacity}%",
    "format-icons":     ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "states": {
      "warning":  30,
      "critical": 15
    },
    "interval": 30
  },

  "custom/voice": {
    "exec": "echo '{\"text\":\"󰍬\",\"tooltip\":\"Voice active — say Hey TOPU\",\"class\":\"voice-active\"}'",
    "return-type": "json",
    "interval": 60,
    "format": "{}",
    "on-click": "pkill -USR1 topu-voice"
  }
}
